[
  "docker",
  "run",
  "--name",
  "mira-e4-cierre-multi",
  "--network",
  "none",
  "--read-only",
  "--tmpfs",
  "/tmp:rw,nosuid,nodev,size=64m",
  "--mount",
  "type=bind,source=[REPOSITORIO_LOCAL],target=/work,readonly",
  "--mount",
  "type=bind,source=[REPOSITORIO_LOCAL],target=/audit,readonly",
  "--mount",
  "type=bind,source=[REPOSITORIO_LOCAL]\\docs\\evidencia,target=/evidence",
  "--env",
  "PYTHONPATH=/work/src",
  "--env",
  "PYTEST_ADDOPTS=-p no:cacheprovider -c /work/pyproject.toml",
  "--env",
  "MIRA_ENFOQUE=multi",
  "--env",
  "MIRA_RED_AISLADA=1",
  "--env",
  "MIRA_SOURCE_ROOT=/work/src",
  "mira-e4-pytest:9.0.2",
  "python",
  "/audit/docs/evidencia/entorno_aislado.py",
  "cierre-multi",
  "/audit/docs/evidencia/aceptacion_comun.py"
]